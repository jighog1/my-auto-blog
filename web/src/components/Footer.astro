---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { SITE } from "@/config";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-8 sm:py-10",
      "border-t border-border",
      "flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between",
    ]}
  >
    <div>
      <p class="font-bold">{SITE.title}</p>
      <p class="mt-1 text-sm text-muted-foreground">{SITE.tagline}</p>
      <div
        class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground"
      >
        <a href="/about" class="hover:text-accent">소개</a>
        <a href="/privacy" class="hover:text-accent">개인정보처리방침</a>
        <a href="/terms" class="hover:text-accent">이용약관</a>
      </div>
    </div>
    <div
      class="flex flex-col items-start gap-3 text-sm text-muted-foreground sm:items-end"
    >
      <Socials />
      <span>&#169; {currentYear} {SITE.title}</span>
    </div>
  </div>
</footer>
