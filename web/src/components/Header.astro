---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-5 -top-full z-50 bg-accent px-4 py-2 text-sm font-semibold text-background focus:top-3"
>
  본문으로 건너뛰기
</a>

<header
  class="sticky top-0 z-40 w-full border-b border-border bg-background/95"
  id="main-header"
>
  <div
    id="top-nav-wrap"
    class:list={[
      "app-layout py-3 sm:py-4",
      "relative flex w-full items-center justify-between gap-4",
    ]}
  >
    <a
      href={import.meta.env.BASE_URL}
      class="flex min-w-0 flex-col py-1 leading-none whitespace-nowrap"
    >
      <span class="text-lg font-extrabold tracking-[-0.025em] sm:text-xl"
        >{SITE.title}</span
      >
      <span
        class="mt-1 hidden text-[0.68rem] font-medium tracking-wide text-muted-foreground md:block"
      >
        {SITE.tagline}
      </span>
    </a>
    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline size-11 self-end p-2.5 sm:hidden"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class:list={[
          "absolute top-full right-5 mt-3 grid w-48 grid-cols-2 place-content-center gap-1 border border-border bg-surface p-3 shadow-lg",
          "[&>li>a]:block [&>li>a]:px-3 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:text-sm [&>li>a]:font-medium [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-2",
          "hidden",
          "sm:static sm:mt-0 sm:flex sm:w-auto sm:gap-x-3 sm:gap-y-0 sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none",
        ]}
      >
        <li class="col-span-2">
          <a
            href={`${import.meta.env.BASE_URL}posts`}
            class:list={{
              "active-nav": isActive(`${import.meta.env.BASE_URL}posts`),
            }}
          >
            글
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={`${import.meta.env.BASE_URL}tags`}
            class:list={{
              "active-nav": isActive(`${import.meta.env.BASE_URL}tags`),
            }}
          >
            주제
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={`${import.meta.env.BASE_URL}about`}
            class:list={{
              "active-nav": isActive(`${import.meta.env.BASE_URL}about`),
            }}
          >
            소개
          </a>
        </li>
        {
          SITE.showArchives && (
            <li class="col-span-2">
              <LinkButton
                href={`${import.meta.env.BASE_URL}archives`}
                class:list={[
                  "focus-outline flex justify-center p-3 sm:p-1",
                  {
                    "active-nav [&>svg]:stroke-accent": isActive(
                      `${import.meta.env.BASE_URL}archives`
                    ),
                  },
                ]}
                title="보관함"
                aria-label="보관함"
              >
                <IconArchive class="hidden sm:inline-block" />
                <span class="sm:sr-only">보관함</span>
              </LinkButton>
            </li>
          )
        }
        <li class="col-span-1 flex items-center justify-center">
          <LinkButton
            href={`${import.meta.env.BASE_URL}search`}
            class:list={[
              "focus-outline flex p-3 sm:p-1",
              {
                "[&>svg]:stroke-accent": isActive(
                  `${import.meta.env.BASE_URL}search`
                ),
              },
            ]}
            title="검색"
            aria-label="검색"
          >
            <IconSearch />
            <span class="sr-only">검색</span>
          </LinkButton>
        </li>
        {
          SITE.lightAndDarkMode && (
            <li class="col-span-1 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                title="화면 테마 전환"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "메뉴 열기" : "메뉴 닫기");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
