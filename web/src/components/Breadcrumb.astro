---
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");
const basePath = import.meta.env.BASE_URL.replace(/\/+$/, "");
const pathWithoutBase = currentUrlPath.startsWith(basePath)
  ? currentUrlPath.slice(basePath.length)
  : currentUrlPath;
const segments = pathWithoutBase.split("/").filter(Boolean);
const routeLabels: Record<string, string> = {
  posts: "글",
  tags: "주제",
  archives: "보관함",
  search: "검색",
  about: "소개",
  privacy: "개인정보처리방침",
  terms: "이용약관",
};
const breadcrumbs = segments.map((segment, index) => ({
  href: `${import.meta.env.BASE_URL}${segments.slice(0, index + 1).join("/")}/`,
  label: /^\d+$/.test(segment)
    ? `${segment}페이지`
    : (routeLabels[segment] ?? decodeURIComponent(segment)),
}));
---

<nav class="app-layout mt-7 mb-3" aria-label="현재 위치">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
    <li><a href={import.meta.env.BASE_URL} class="hover:text-accent">홈</a></li>
    {
      breadcrumbs.map((breadcrumb, index) => (
        <li class="flex items-center gap-2">
          <span aria-hidden="true">/</span>
          {index === breadcrumbs.length - 1 ? (
            <span aria-current="page">{breadcrumb.label}</span>
          ) : (
            <a href={breadcrumb.href} class="hover:text-accent">
              {breadcrumb.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
