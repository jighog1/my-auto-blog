---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import RecentPostsSlider from "@/components/RecentPostsSlider.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getWorkRelevantPosts } from "@/utils/getWorkRelevantPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const publishedPosts = sortedPosts.filter(({ data }) => !data.draft);
const featuredPosts = publishedPosts.slice(0, 3);
const workPosts = getWorkRelevantPosts(publishedPosts, 3);
const latestPosts = publishedPosts.slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-base-url={import.meta.env.BASE_URL}
    class="app-layout"
  >
    <h1 class="sr-only">AI 브리핑룸 최근 글과 전체 아티클</h1>

    <RecentPostsSlider posts={featuredPosts} />

    {
      latestPosts.length > 0 && (
        <div class="grid items-start gap-12 py-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-10 xl:grid-cols-[minmax(0,1fr)_20rem] xl:gap-14">
          <section id="recent-posts" class="min-w-0">
            <div class="mb-5 flex items-end justify-between gap-4">
              <div>
                <h2 class="text-3xl font-extrabold tracking-[-0.035em] sm:text-4xl">
                  전체 아티클
                </h2>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">
                  새로 발행된 순서대로 모든 브리핑을 확인하세요.
                </p>
              </div>
              <LinkButton
                href={`${import.meta.env.BASE_URL}posts/`}
                class="shrink-0 text-sm font-semibold text-accent"
              >
                전체 글
                <IconArrowRight class="inline-block rtl:-rotate-180" />
              </LinkButton>
            </div>
            <ul>
              {latestPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>

          {workPosts.length > 0 && (
            <aside
              id="work-briefing"
              class="rounded-xl bg-muted p-5 sm:p-6 lg:sticky lg:top-24"
              aria-labelledby="work-heading"
            >
              <p class="text-sm font-bold text-signal">업무 활용</p>
              <h2
                id="work-heading"
                class="mt-1 text-2xl font-extrabold tracking-[-0.025em]"
              >
                WORK
              </h2>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                최신순이 아닌, 바로 써볼 업무 아이디어를 골랐습니다.
              </p>
              <ol class="mt-5 divide-y divide-border">
                {workPosts.map((post, index) => (
                  <li class="py-4 first:pt-0 last:pb-0">
                    <a
                      href={getPath(post.id, post.filePath)}
                      class="group grid min-h-11 grid-cols-[2rem_minmax(0,1fr)] gap-3"
                    >
                      <span
                        class="flex size-8 items-center justify-center rounded-md bg-surface text-sm font-extrabold text-accent"
                        aria-hidden="true"
                      >
                        {index + 1}
                      </span>
                      <span class="pt-1 text-sm leading-6 font-bold text-foreground underline-offset-4 group-hover:text-accent group-hover:underline">
                        {post.data.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </aside>
          )}
        </div>
      )
    }

    <div class="mb-14 text-center">
      <LinkButton href={`${import.meta.env.BASE_URL}posts/`}>
        모든 글 보기
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    const baseUrl = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.baseUrl;
    if (indexLayout && baseUrl) {
      sessionStorage.setItem("backUrl", baseUrl);
    }
  });
</script>
