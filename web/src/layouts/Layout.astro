---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import {
  PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN,
  PUBLIC_GOOGLE_SITE_VERIFICATION,
} from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

const structuredData = pubDatetime
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: socialImageURL.href,
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: {
        "@type": "Organization",
        name: author,
        ...(profile && { url: profile }),
      },
      publisher: {
        "@type": "Organization",
        name: SITE.title,
        url: SITE.website,
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      alternateName: SITE.tagline,
      url: SITE.website,
      description,
      inLanguage: SITE.lang,
    };
const structuredDataJSON = JSON.stringify(structuredData).replaceAll(
  "<",
  "\\u003c"
);
const cloudflareWebAnalyticsConfig = JSON.stringify({
  token: PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN,
});
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={SITE.lang ?? "en"}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Load Font -->
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content="ko_KR" />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJSON}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="#f7f6f2" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <meta
      name="naver-site-verification"
      content="9e838e141b4bd814c39cd8152d2dbf3028d65575"
    />
    <meta
      name="google-site-verification"
      content="47H558O3LtDO5J2oawdao5F0e0aDKO-DBFj9az32DqM"
    />

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <slot />

    {
      PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN && (
        <script
          type="module"
          is:inline
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={cloudflareWebAnalyticsConfig}
        />
      )
    }

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>

    <script>
      const mermaidSources = new WeakMap<HTMLElement, string>();
      let mermaidRendering = false;
      let mermaidRerenderRequested = false;

      const getThemeToken = (name: string) =>
        getComputedStyle(document.documentElement)
          .getPropertyValue(name)
          .trim();

      const parseRgb = (color: string): [number, number, number] | null => {
        const values = color.match(/[\d.]+/g)?.map(Number);
        return values && values.length >= 3
          ? [values[0], values[1], values[2]]
          : null;
      };

      const relativeLuminance = ([red, green, blue]: [
        number,
        number,
        number,
      ]) => {
        const channels = [red, green, blue].map(value => {
          const channel = value / 255;
          return channel <= 0.04045
            ? channel / 12.92
            : ((channel + 0.055) / 1.055) ** 2.4;
        });
        return (
          channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722
        );
      };

      function applyMermaidNodeContrast(nodes: HTMLElement[]) {
        const darkText = getThemeToken("--diagram-text-dark");
        const lightText = getThemeToken("--diagram-text-light");

        nodes.forEach(diagram => {
          diagram.querySelectorAll<SVGGElement>("g.node").forEach(node => {
            const shape = node.querySelector<SVGElement>(
              "rect, polygon, circle, ellipse, path"
            );
            if (!shape) return;

            const fill = parseRgb(getComputedStyle(shape).fill);
            if (!fill) return;

            const luminance = relativeLuminance(fill);
            const darkContrast = (luminance + 0.05) / 0.05;
            const lightContrast = 1.05 / (luminance + 0.05);
            node.style.setProperty(
              "--diagram-node-text",
              darkContrast >= lightContrast ? darkText : lightText
            );
          });
        });
      }

      async function renderMermaid(reset = false) {
        if (mermaidRendering) {
          mermaidRerenderRequested ||= reset;
          return;
        }

        mermaidRendering = true;
        const allNodes = Array.from(
          document.querySelectorAll<HTMLElement>(".mermaid")
        );

        try {
          allNodes.forEach(node => {
            if (
              !mermaidSources.has(node) &&
              !node.hasAttribute("data-processed")
            ) {
              mermaidSources.set(node, node.textContent?.trim() ?? "");
            }

            if (reset) {
              const source = mermaidSources.get(node);
              if (source === undefined) return;
              node.removeAttribute("data-processed");
              node.removeAttribute("data-render-error");
              node.replaceChildren(source);
            }
          });

          const nodes = allNodes.filter(
            node => !node.hasAttribute("data-processed")
          );
          if (nodes.length === 0) return;

          const { default: mermaid } = await import("mermaid");
          const foreground = getThemeToken("--foreground");
          const border = getThemeToken("--border");
          const node = getThemeToken("--diagram-node");
          const secondary = getThemeToken("--diagram-secondary");
          const cluster = getThemeToken("--diagram-cluster");
          const edgeLabel = getThemeToken("--diagram-edge-label");

          mermaid.initialize({
            startOnLoad: false,
            securityLevel: "strict",
            theme: "base",
            fontFamily: "var(--font-app)",
            themeVariables: {
              background: getThemeToken("--background"),
              primaryColor: node,
              primaryTextColor: foreground,
              primaryBorderColor: border,
              secondaryColor: secondary,
              secondaryTextColor: foreground,
              secondaryBorderColor: border,
              tertiaryColor: cluster,
              tertiaryTextColor: foreground,
              tertiaryBorderColor: border,
              lineColor: getThemeToken("--muted-foreground"),
              textColor: foreground,
              mainBkg: node,
              nodeBorder: border,
              clusterBkg: cluster,
              clusterBorder: border,
              titleColor: foreground,
              edgeLabelBackground: edgeLabel,
            },
          });

          await mermaid.run({ nodes });
          applyMermaidNodeContrast(nodes);
        } catch {
          allNodes.forEach(node =>
            node.setAttribute("data-render-error", "true")
          );
        } finally {
          mermaidRendering = false;
          if (mermaidRerenderRequested) {
            mermaidRerenderRequested = false;
            void renderMermaid(true);
          }
        }
      }

      document.addEventListener("astro:page-load", () => renderMermaid());
      document.addEventListener("theme:change", () => renderMermaid(true));
      void renderMermaid();
    </script>
  </body>
</html>
